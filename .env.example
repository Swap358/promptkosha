# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Find both values in Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The public "anon" key (or the newer "publishable" key). Safe for the browser ONLY because
# Row Level Security protects the data. NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# Your site's public address, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
